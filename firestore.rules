rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pixel designs - public read, authenticated create, owner update/delete
    match /pixelDesigns/{designId} {
      // Anyone can read designs (for sharing via link)
      allow read: if true;
      // Only authenticated users can create designs
      allow create: if request.auth != null;
      // Only owner can update or delete
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Boat configurations - public read, authenticated create, owner update/delete
    match /boatConfigs/{configId} {
      // Anyone can read configs (for sharing via link)
      allow read: if true;
      // Only authenticated users can create configs
      allow create: if request.auth != null;
      // Only owner can update or delete
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
