rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // users/{userId} — единый блок правил ниже (см. «Профили сотрудников»). Раньше здесь был
    // отдельный блок `allow write: if uid==userId`, который позволял пользователю писать СВОЙ
    // документ целиком, включая role/centers/active → self-escalation до owner. Убрано.

    // Pixel designs - public read, authenticated create, owner update/delete
    match /pixelDesigns/{designId} {
      // Anyone can read designs (for sharing via link)
      allow read: if true;
      // Only authenticated users can create designs
      allow create: if request.auth != null;
      // Only owner can update or delete
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Boat configurations - public read, authenticated create, owner update/delete
    match /boatConfigs/{configId} {
      // Anyone can read configs (for sharing via link)
      allow read: if true;
      // Only authenticated users can create configs
      allow create: if request.auth != null;
      // Only owner can update or delete
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Администратор прайс-листа определяется по email (см. src/config/access.ts).
    // email_verified обязателен: иначе можно зарегистрировать admin@runferry.de без
    // подтверждения почты и получить админ-права записи.
    function isPriceAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'admin@runferry.de';
    }

    // Прайс-лист (каталог работ, наборов, материалов, настроек) — публичное чтение,
    // запись только администратору.
    match /priceList/{docId} {
      allow read: if true;
      allow write: if isPriceAdmin();
    }

    // Архив цен (история версий прайса). Пишется/читается только администратором.
    match /priceArchive/{snapId} {
      allow read, list, create, delete: if isPriceAdmin();
    }

    // Оплаты и чеки. Пишутся ТОЛЬКО backend-ом (firebase-admin, минуя правила).
    // С клиента — только чтение админом (содержат суммы/ФОП/статусы).
    match /payments/{orderId} {
      allow read, list: if isPriceAdmin();
    }

    // Журнал оповещений клиента (готова калькуляция, відправлення тощо). Пишет только backend
    // (Admin SDK, /api/notify — проверка админ-токена там). Клиент/фронт — только чтение (админ).
    match /notifications/{ntfId} {
      allow read, list: if isPriceAdmin();
      allow write: if false;
    }

    // Профили сотрудников (роли/центры/права) + легаси-персональные данные (boats/settings).
    // Своё — читать можно; список — владелец. RBAC-поля (role/centers/active/createdBy) пишет
    // ТОЛЬКО владелец (или backend Admin SDK, минуя правила). Пользователь может писать СВОЙ
    // документ (легаси boats/settings/updatedAt), но НЕ трогая RBAC-поля — иначе self-escalation.
    function touchesRbacKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'centers', 'active', 'createdBy']);
    }
    match /users/{userId} {
      allow get: if isPriceAdmin() || (request.auth != null && request.auth.uid == userId);
      allow list: if isPriceAdmin();
      // Создание: владелец — что угодно; сам пользователь — только БЕЗ RBAC-полей.
      allow create: if isPriceAdmin()
        || (request.auth != null && request.auth.uid == userId
            && !request.resource.data.keys().hasAny(['role', 'centers', 'active', 'createdBy']));
      // Обновление: владелец — что угодно; сам пользователь — только не меняя RBAC-полей.
      allow update: if isPriceAdmin()
        || (request.auth != null && request.auth.uid == userId && !touchesRbacKeys());
      allow delete: if isPriceAdmin();
    }

    // Реестр сервисных центров (зон). Читать — авторизованным (мастерам нужны назви);
    // создавать/менять — только владелец.
    match /serviceCenters/{centerId} {
      allow read, list: if request.auth != null;
      allow write: if isPriceAdmin();
    }

    // Сметы. Прямое чтение — ТОЛЬКО администратор (внутренняя экономика: ставка, подытоги,
    // сезонный коэф., createdBy, requestId/PII). Клиент видит смету через backend
    // /api/estimates/:id/public — безопасный вид без внутренних полей.
    // Запись/удаление — только админ И только пока смета НЕ оплачена (чтобы пересохранение из
    // редактора мастера не затёрло backend-поля оплаты: status=paid, paymentId, taxUrl → защита
    // от двойного списания). Сам backend (Admin SDK) правила обходит и статусы пишет свободно.
    match /priceEstimates/{estId} {
      allow get, list: if isPriceAdmin();
      allow create: if isPriceAdmin();
      allow update, delete: if isPriceAdmin() && resource.data.status != 'paid';
    }

    // Предложения клиенту (наборы вариантов сметы). Прямой доступ — только администратор; клиент
    // видит варианты и выбирает путь через backend (/api/offers/:id/public, /choose) — Admin SDK.
    match /estimateOffers/{offerId} {
      allow read, list, create, update, delete: if isPriceAdmin();
    }

    // Заявки на обслуживание (наша локальная сущность-хаб). Содержат контакт клиента (PII) и
    // связи с калькуляциями/оплатой — доступ только администратору.
    match /serviceRequests/{reqId} {
      allow read, list, create, update, delete: if isPriceAdmin();
    }

    // Редактируемые тексты сервиса (соглашение и т.п.) — публичное чтение,
    // запись только администратору.
    match /serviceContent/{docId} {
      allow read: if true;
      allow write: if isPriceAdmin();
    }

    // Сессии диалога клиента с ИИ/менеджером — доступ по непубличной ссылке (16-символьный id).
    // get — по знанию id (клиент/менеджер по ссылке); list (перечисление всех сессий, в т.ч.
    // с PII contact) — только администратор. Аноним создаёт и дополняет свою сессию по её id.
    // MVP: update по знанию id; ужесточить полевыми правилами позже.
    match /chatSessions/{sessionId} {
      allow get: if true;
      allow list: if isPriceAdmin();
      allow create: if true;
      // Клиент дополняет свою сессию по знанию id, но не может подменить id/дату создания,
      // не может УКОРОТИТЬ историю (size только растёт) и не может менять серверо/менеджеро-
      // контролируемые поля: паузу бота и канал/адресата мессенджера. (aiUsage НЕ закрепляем —
      // веб-клиент легитимно накапливает стоимость ИИ при каждом ответе.)
      // Это ограничивает злоупотребление по знанию id (id криптостойкий). Админ — полный доступ.
      allow update: if isPriceAdmin()
        || (request.resource.data.id == resource.data.id
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.messages.size() >= resource.data.messages.size()
            && request.resource.data.get('botPaused', false) == resource.data.get('botPaused', false)
            && request.resource.data.get('channel', '') == resource.data.get('channel', '')
            && request.resource.data.get('channelUserId', '') == resource.data.get('channelUserId', '')
            && request.resource.data.get('businessConnectionId', '') == resource.data.get('businessConnectionId', ''));
      allow delete: if isPriceAdmin();
    }

    // База знаний (консультации, самопомощь) — публичное чтение, запись администратору
    match /knowledgeArticles/{docId} {
      allow read: if true;
      allow write: if isPriceAdmin();
    }

    // Обратная связь клиентов — создаёт любой; читает/изменяет только администратор
    // (содержит контактные данные клиента). Лёгкая защита от абьюза — лимит полей;
    // полноценно — App Check + rate-limit (в бэклоге).
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().size() <= 14;
      allow read, update, delete: if isPriceAdmin();
    }

    // Правки поведения ИИ — публичное чтение (инжектятся в промпт), запись администратору
    match /behaviorCorrections/{docId} {
      allow read: if true;
      allow write: if isPriceAdmin();
    }

    // База клиентов и их корабликов — создаёт любой (опросник); читает/меняет только
    // администратор (содержит контактные данные). Пополнение из 1С идёт через сервер
    // (Admin SDK минует правила).
    match /clientBoats/{docId} {
      // Лёгкая защита от абьюза — лимит полей; полноценно — App Check + rate-limit (в бэклоге).
      allow create: if request.resource.data.keys().size() <= 20;
      allow read, update, delete: if isPriceAdmin();
    }

    // Шаблоны жалоб (симптом → диагностика + варианты ремонта) — публичное чтение
    // (контекст для ИИ-оценки), запись администратору.
    match /complaintTemplates/{docId} {
      allow read: if true;
      allow write: if isPriceAdmin();
    }

    // Задачи сервиса (отправка комплектующих, доп. работа…) — создаёт любой (клиент из
    // чата), читает/меняет только администратор. Лёгкая защита от абьюза — лимит полей.
    match /serviceTasks/{docId} {
      allow create: if request.resource.data.keys().size() <= 14;
      allow read, update, delete: if isPriceAdmin();
    }

    // Профили клиентов (ключ = нормализованный телефон, содержит PII). Прямая клиентская запись
    // ЗАКРЫТА: аноним по угадываемому ключу мог бы перезаписать чужой профиль. Клиентские потоки
    // (опросник, заявка) пишут через backend /api/client-profiles/upsert (Admin SDK, безопасное
    // слияние: имя/email только если пусто, массивы arrayUnion). Мессенджеры — тоже сервер.
    match /clientProfiles/{docId} {
      allow create, update: if false;
      allow read, list, delete: if isPriceAdmin();
    }

    // Каталог прошивок пульта: бренды/ветки (флаг publicAccess — доступно всем). Читают вошедшие
    // (страница «Прошивки пульта» фильтрует список по доступу); пишет/синхронизирует только владелец.
    match /firmwareBrands/{brandId} {
      allow read, list: if request.auth != null;
      allow write: if isPriceAdmin();
    }
    match /firmwareBranches/{branchId} {
      allow read, list: if request.auth != null;
      allow write: if isPriceAdmin();
    }
    // Персональный доступ пользователя к прошивкам (ключ = email). Отдельно от users (RBAC по uid).
    // get — вошедший читает свой док (страница прошивок); list всех грантов — только владелец.
    match /firmwareUserAccess/{email} {
      allow get: if request.auth != null;
      allow list: if isPriceAdmin();
      allow write: if isPriceAdmin();
    }

    // ФОПы: мета (fops) и СЕКРЕТЫ (fopSecrets — платёжные ключи/токени) доступны ТОЛЬКО backend-у
    // (Admin SDK минует правила). Клиентский доступ запрещён повністю — секрети не потрапляють у браузер.
    // Управление — через /api/fops/admin (перевірка власника на сервері).
    match /fops/{id} {
      allow read, write: if false;
    }
    match /fopSecrets/{id} {
      allow read, write: if false;
    }

    // Шаблоны посылок Новой Почты (параметры для создания ТТН). Не-секрет; управляет владелец.
    match /npTemplates/{id} {
      allow read, list: if isPriceAdmin();
      allow write: if isPriceAdmin();
    }

    // Продажі корабликів: каталог (моделі/опції/дропшипери) + замовлення (картотека).
    // Внутрішня картотека без публічної вітрини — тільки власник.
    match /boatModels/{id} {
      allow read, list, write: if isPriceAdmin();
    }
    match /boatOptions/{id} {
      allow read, list, write: if isPriceAdmin();
    }
    match /dropshippers/{id} {
      allow read, list, write: if isPriceAdmin();
    }
    match /boatOrders/{id} {
      allow read, list, write: if isPriceAdmin();
    }

    // Журнал дзвінків (зеркало операторского бота + вебхук Kyivstar): СОЗДАЁТ только backend
    // (Admin SDK). Владелец на канбане «Дзвінки» может ОБНОВЛЯТЬ карточки (workflowStatus,
    // notes — рабочий процесс: нові → оброблені → архів), но не создавать/удалять.
    match /callEvents/{id} {
      allow read, list: if isPriceAdmin();
      allow update: if isPriceAdmin();
      allow create, delete: if false;
    }
    match /callResults/{id} {
      allow read, list: if isPriceAdmin();
      allow update: if isPriceAdmin();
      allow create, delete: if false;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
