{
  "name": "runferry-telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RunFerry: Telegram-бот оператора + веб-панель. Карточки входящих звонков из 1С/Binotel, действия по клиенту, фиксация результатов разговора.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "firebase-admin": "^13.0.0",
    "google-auth-library": "^9.15.1",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
