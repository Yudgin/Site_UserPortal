rules_version = '2';

// Правила Firebase Storage.
// Изображения базы знаний: публичное чтение (их видят клиенты в статьях),
// запись/удаление — только администратор (тот же email, что и в firestore.rules),
// с ограничением на размер и тип файла. Всё остальное — запрещено.
service firebase.storage {
  match /b/{bucket}/o {

    match /knowledge/{articleId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'admin@runferry.de'
        && request.auth.token.email_verified == true
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
