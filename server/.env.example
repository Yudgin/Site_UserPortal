# Server configuration
PORT=3002

# Settings API configuration (1C) — real values go to server/.env (never commit them)
SETTINGS_API_HOST=your-1c-host.example.com
SETTINGS_API_PORT=8812
SETTINGS_API_PATH=/InfoBase1/hs/ad
SETTINGS_API_USER=your-username
SETTINGS_API_PASS=your-password

# TurboSMS Configuration
TURBOSMS_TOKEN=your-turbosms-token
TURBOSMS_SENDER=RUNFERRY

# Nova Poshta Configuration
NP_API_KEY=your-novaposhta-api-key

# Anthropic (Claude) API — для AI-редактора текстов и AI-оценки стоимости
# Ключ живёт только на сервере, никогда не попадает на фронтенд
ANTHROPIC_API_KEY=your-anthropic-api-key

# Telegram-бот (канал агрегатора мессенджеров)
# Токен от @BotFather. Секрет вебхука — произвольная строка, ею защищён приём апдейтов.
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret

# Viber-бот (канал агрегатора мессенджеров)
# Токен Viber Chatbot (Bot API) — создаётся через панель/партнёра Viber (см. docs/messenger-integration-plan.md).
# VIBER_WEBHOOK_SECRET — произвольная строка, ею защищён эндпоинт /api/viber/setup (сам вебхук проверяется подписью Viber).
VIBER_BOT_TOKEN=your-viber-bot-token
VIBER_WEBHOOK_SECRET=your-random-viber-setup-secret

# Firebase project id для firebase-admin (серверная запись chatSessions/clientProfiles).
# Креды — через ADC: локально `gcloud auth application-default login`, в деплое — сервис-аккаунт.
FIREBASE_PROJECT_ID=droidmaps-runferry

# Оплаты (LiqPay/monobank Частини) + авто-чеки Checkbox. МУЛЬТИ-ФОП: JSON-массив ФОПов;
# какой ФОП принял оплату — тем же ФОП выбивается чек (его Checkbox). Секреты только здесь.
# Пример: [{"id":"fop1","name":"ФОП Іваненко","liqpay":{"publicKey":"i00..","privateKey":"sandbox_.."},
#          "monoChast":{"storeId":"..","storeSecret":".."},"checkbox":{"licenseKey":"..","pinCode":"..","cashierName":"ФОП Іваненко"}}]
FOPS_CONFIG=[]
# Публичный URL бэкенда (для server_url/result_callback банков). В проде — URL Cloud Run.
PUBLIC_BASE_URL=https://runferry-backend-98000160958.europe-west3.run.app
# true → LiqPay в песочнице, а также тестовые базовые URL банков/чеков (переопределяемо ниже)
PAYMENTS_SANDBOX=false
# Токен для служебных эндпоинтов оплат (крон): POST /api/pay/reconcile, GET /api/pay/unfiscalized,
# POST /api/pay/:orderId/refiscalize (заголовок x-admin-token). Админ-UI ходит по Firebase ID-токену
# (Authorization: Bearer) — токен нужен только для внешнего крона. Пусто → пускает только по ID-токену.
PAYMENTS_ADMIN_TOKEN=
# Chat id владельца в Telegram для алертов «гроші є, чек ні» (узнать: написать боту, посмотреть update).
# Пусто → алерты выключены (только console.error). Использует TELEGRAM_BOT_TOKEN.
OWNER_TELEGRAM_CHAT_ID=
# Крон-реконсиляция (добивает застрявшие monobank-заявки и повторяет непробитые чеки).
# PAYMENTS_RECONCILE=false — выключить; PAYMENTS_RECONCILE_MS — период (мс, по умолчанию 180000).
# PAYMENTS_RECONCILE=false
# PAYMENTS_RECONCILE_MS=180000
# Переопределение базовых URL (для sandbox/dev): по умолчанию прод
# CHECKBOX_BASE_URL=https://dev-api.checkbox.in.ua
# MONO_CHAST_BASE_URL=https://u2-demo-ext.mono.st4g3.com
