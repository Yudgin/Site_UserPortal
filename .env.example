# Firebase Configuration (public web config — not secret)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
VITE_USE_MOCK_API=true
VITE_BACKEND_URL=http://localhost:3002

# App Configuration
VITE_APP_NAME=Bait Boat Portal

# 1C Flash API credentials for the Vite dev proxy, format user:pass.
# No VITE_ prefix — secrets must never get the VITE_ prefix,
# otherwise Vite inlines them into the browser bundle.
FLASH_API_AUTH=your-username:your-password

# TurboSMS token lives in server/.env (server-side only), not here.
